<idea-plugin>
    <dependencies>
        <module name="kilo.jetbrains.backend"/>
        <module name="kilo.jetbrains.shared"/>
        <plugin id="com.intellij.mcpServer" optional="true" config-file="kilo.jetbrains.cs-cloud-mcp.xml"/>
    </dependencies>

    <extensionPoints>
        <extensionPoint name="ideMcpSessionFactory"
                        interface="ai.kilocode.cscloud.mcp.IdeMcpSessionFactory"/>
    </extensionPoints>

    <extensions defaultExtensionNs="ai.kilocode.jetbrains">
        <connectionProvider implementation="ai.kilocode.cscloud.CsCloudConnectionProvider"/>
    </extensions>
</idea-plugin>
